# ============================================================
# ChainCoder Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
#
# Usage (Git Bash / Linux / Mac):
#   cp .env.example .env
# Usage (Windows CMD):
#   copy .env.example .env
# Usage (PowerShell):
#   Copy-Item .env.example .env
# ============================================================


# ============================================================
# Server
# ============================================================

NODE_ENV=development
PORT=5000


# ============================================================
# Hyperledger Fabric - Channel & Chaincode
# ============================================================

FABRIC_CHANNEL=sihchannel
FABRIC_CHAINCODE=sih-contract


# ============================================================
# BEL Organization
# MSP ID must match CORE_PEER_LOCALMSPID in docker-compose-peer.yaml
# ============================================================

BEL_MSP_ID=BELMSP
BEL_PEER_ENDPOINT=localhost:7051
BEL_TLS_SERVER_NAME=peer0.bel.sih26125.local

# Path to enrolled BEL admin MSP (relative to backend/ directory)
# Contains: cacerts/, keystore/, signcerts/
BEL_MSP_PATH=./fabric/bel/msp

# Path to BEL peer TLS CA certificate (relative to backend/ directory)
BEL_TLS_CA_PATH=./fabric/bel/tls-ca.pem


# ============================================================
# Auditor Organization
# ============================================================

AUDITOR_MSP_ID=AuditorMSP
AUDITOR_PEER_ENDPOINT=localhost:8051
AUDITOR_TLS_SERVER_NAME=peer0.auditor.sih26125.local

# Path to enrolled Auditor admin MSP (relative to backend/ directory)
AUDITOR_MSP_PATH=../blockchain/sih-network/.msp-enroll/auditorchanneladmin/msp

# Path to Auditor peer TLS CA certificate (relative to backend/ directory)
AUDITOR_TLS_CA_PATH=../blockchain/sih-network/organizations/peerOrganizations/auditor.sih26125.local/peers/peer0.auditor.sih26125.local/tls/tlscacerts/tls-localhost-8054.pem


# ============================================================
# Contractor Organization
# ============================================================

CONTRACTOR_MSP_ID=ContractorMSP
CONTRACTOR_PEER_ENDPOINT=localhost:9051
CONTRACTOR_TLS_SERVER_NAME=peer0.contractor.sih26125.local

# Path to enrolled Contractor admin MSP (relative to backend/ directory)
CONTRACTOR_MSP_PATH=../blockchain/sih-network/.msp-enroll/contractorchanneladmin/msp

# Path to Contractor peer TLS CA certificate (relative to backend/ directory)
CONTRACTOR_TLS_CA_PATH=../blockchain/sih-network/organizations/peerOrganizations/contractor.sih26125.local/peers/peer0.contractor.sih26125.local/tls/tlscacerts/tls-localhost-9054.pem


# ============================================================
# Orderer (informational - used in documentation/scripts)
# ============================================================

ORDERER_ENDPOINT=orderer1.sih26125.local:7050


# ============================================================
# IPFS / Kubo
# Default local Kubo node addresses - do not change unless
# you run IPFS on a non-default port.
# ============================================================

IPFS_API_URL=http://127.0.0.1:5001/api/v0
IPFS_GATEWAY_URL=http://127.0.0.1:8080


# ============================================================
# Authentication
# IMPORTANT: Change JWT_SECRET before any real deployment.
# Use a long random string (32+ characters).
# ============================================================

JWT_SECRET=change-this-to-a-long-random-secret-before-deployment


# ============================================================
# Database (reserved for future use - not used yet)
# ============================================================

DB_URL=
